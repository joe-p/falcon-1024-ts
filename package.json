{
  "name": "falcon-1024",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsx scripts/build.ts && esbuild src/index.ts --bundle --outdir=dist --target=es2022 --format=esm && cp src/falcon_wasm.wasm dist/ && tsc -p tsconfig.build.json",
    "test": "vitest run tests",
    "test:browser": "pnpm run build && pnpm exec playwright test",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.60.0",
    "serve": "^14.2.6",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-p/falcon-1024-ts.git"
  },
  "homepage": "https://github.com/joe-p/falcon-1024-ts#readme",
  "bugs": {
    "url": "https://github.com/joe-p/falcon-1024-ts/issues"
  }
}
